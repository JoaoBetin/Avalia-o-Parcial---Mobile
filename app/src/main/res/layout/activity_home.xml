<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/Heading" android:text="@string/app_name" android:textSize="24sp" />
        <Space android:layout_width="1dp" android:layout_height="32dp" />
        <TextView style="@style/Body" android:text="@string/eyebrow" android:textSize="11sp" android:letterSpacing="0.12" android:textStyle="bold" android:textColor="@color/accent" />
        <TextView style="@style/Heading" android:layout_marginTop="12dp" android:text="@string/home_title" />
        <TextView style="@style/Body" android:layout_marginTop="12dp" android:text="@string/home_description" />
        <TextView style="@style/Heading" android:layout_marginTop="32dp" android:layout_marginBottom="16dp" android:text="@string/lists_heading" android:textSize="20sp" />
        <LinearLayout android:id="@+id/listContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView style="@style/Body" android:layout_marginTop="12dp" android:text="@string/home_note" android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
